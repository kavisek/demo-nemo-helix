# prod environment for docker compose. Copy to envs/prod.env (gitignored)
# and fill in real values. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENVIRONMENT=prod
AIRFLOW_UID=50000
AIRFLOW_PORT=7022
POSTGRES_PORT=7434
FLOWER_PORT=7025
AIRFLOW_LOGS_DIR=./logs/prod
WORKER_REPLICAS=2
LOAD_EXAMPLES=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
FERNET_KEY=
JWT_SECRET=prod-jwt-secret-change-me
API_SECRET_KEY=prod-api-secret-change-me
# NeMo Helix API the DAGs call, reached through the published port of the nemo-helix container.
NEMO_HELIX_URL=http://host.docker.internal:7001
NEMO_HELIX_WORKSPACE=default
