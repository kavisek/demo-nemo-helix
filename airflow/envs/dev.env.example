# dev environment for docker compose. Copy to envs/dev.env (gitignored)
# and fill in real values. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENVIRONMENT=dev
AIRFLOW_UID=50000
AIRFLOW_PORT=7002
POSTGRES_PORT=7432
FLOWER_PORT=7005
AIRFLOW_LOGS_DIR=./logs/dev
WORKER_REPLICAS=1
LOAD_EXAMPLES=false
ADMIN_USERNAME=airflow
ADMIN_PASSWORD=airflow
POSTGRES_PASSWORD=airflow
FERNET_KEY=
JWT_SECRET=dev-jwt-secret-change-me
API_SECRET_KEY=dev-api-secret-change-me
# Quick experiments only; move anything you keep into requirements.txt.
_PIP_ADDITIONAL_REQUIREMENTS=
# NeMo Helix API the DAGs call, reached through the published port of the nemo-helix container.
NEMO_HELIX_URL=http://host.docker.internal:7001
NEMO_HELIX_WORKSPACE=default
