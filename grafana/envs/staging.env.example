# staging environment for docker compose. Copy to envs/staging.env (gitignored)
# and fill in real values. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENVIRONMENT=staging
GRAFANA_PORT=7013
PGADMIN_PORT=7014
POSTGRES_PORT=7441
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_SECRET_KEY=staging-grafana-secret-change-me
POSTGRES_PASSWORD=change-me
PGADMIN_EMAIL=pgadmin4@pgadmin.org
PGADMIN_PASSWORD=change-me
# Airflow metadata DB of the airflow-staging stack, read by the NeMo Helix Eval Pipeline dashboard.
AIRFLOW_DB_HOST=host.docker.internal
AIRFLOW_DB_PORT=7433
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me
