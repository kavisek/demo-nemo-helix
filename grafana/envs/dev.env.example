# dev environment for docker compose. Copy to envs/dev.env (gitignored)
# and fill in real values. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENVIRONMENT=dev
GRAFANA_PORT=7003
PGADMIN_PORT=7004
POSTGRES_PORT=7440
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_SECRET_KEY=dev-grafana-secret-change-me
POSTGRES_PASSWORD=postgres
PGADMIN_EMAIL=pgadmin4@pgadmin.org
PGADMIN_PASSWORD=admin
# Airflow metadata DB of the airflow-dev stack, read by the NeMo Helix Eval Pipeline dashboard.
AIRFLOW_DB_HOST=host.docker.internal
AIRFLOW_DB_PORT=7432
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
