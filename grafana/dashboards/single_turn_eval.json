          "query": "",
          "rawQuery": true,
          "rawSql": "\nSELECT task_id, round(avg(duration)::numeric, 1) AS avg_seconds, count(*) AS runs\nFROM task_instance\nWHERE dag_id = 'nemo_helix_single_turn_eval_pipeline' AND state = 'success' AND $__timeFilter(start_date)\nGROUP BY task_id\nORDER BY avg_seconds DESC;\n",
